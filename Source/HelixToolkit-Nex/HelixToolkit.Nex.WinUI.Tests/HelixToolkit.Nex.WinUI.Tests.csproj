<Project Sdk="MSTest.Sdk/3.6.4">
    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
        <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <TargetFramework>net9.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseVSTest>true</UseVSTest>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
        <ProjectReference Include="..\HelixToolkit.Nex.WinUI\HelixToolkit.Nex.WinUI.csproj" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <Compile Include="..\HelixToolkit.Nex.WinUI\HelixViewport.Lifecycle.cs" Link="HelixViewport.Lifecycle.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    </ItemGroup>
</Project>
