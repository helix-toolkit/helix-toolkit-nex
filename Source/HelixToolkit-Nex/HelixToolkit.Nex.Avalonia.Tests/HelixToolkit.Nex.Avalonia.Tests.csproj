<Project Sdk="MSTest.Sdk/3.6.4">
    <!-- Mirror the main Avalonia project's conditional TFM: -windows on Windows so the
         transitive DirectX (Windows_Path) dependency resolves; plain net8.0 on Linux. -->
    <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
        <TargetFramework>net8.0-windows</TargetFramework>
    </PropertyGroup>
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseVSTest>true</UseVSTest>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
        <PackageReference Include="FsCheck" Version="3.3.3" />
        <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    </ItemGroup>

    <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
        <ProjectReference Include="..\HelixToolkit.Nex.Avalonia\HelixToolkit.Nex.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="MSTest.Analyzers" Version="4.2.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="MSTest.TestAdapter" Version="4.2.1" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="MSTest.TestFramework" Version="4.2.1" />
    </ItemGroup>
</Project>
