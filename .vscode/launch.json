                    // targets the Windows App SDK TFM, so it lands under bin/x64.
                    "label": "Interop / WinUI (Windows only)",
                    "value": "Samples/Interop/WinUI/bin/x64/Debug/net9.0-windows10.0.22621.0/WinUIInterop.exe"
                },
                {
                    // Windows-only. Targets net9.0-windows at AnyCPU.
                    "label": "Interop / Wpf (Windows only)",
                    "value": "Samples/Interop/Wpf/bin/Debug/net9.0-windows/WpfInterop.exe"
                }
