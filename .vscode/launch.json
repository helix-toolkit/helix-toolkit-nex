{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Generic launcher: pick any sample from the dropdown prompt.
            // Platform detection: the base `program` uses the LinuxDebug build
            // output; the "windows" block overrides it with the Debug output
            // (and the .exe apphost). VS Code only resolves the ${input:}
            // referenced by the active OS, so you are prompted exactly once.
            // The preLaunchTask builds only the picked sample (it reuses this
            // same ${input:}), so no extra prompt and no whole-solution build.
            "name": "Run Sample (pick project)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-sample",
            "program": "${workspaceFolder}/Source/HelixToolkit-Nex/${input:sample}",
            "args": [],
            "cwd": "${workspaceFolder}/Source/HelixToolkit-Nex",
            "console": "internalConsole",
            "stopAtEntry": false,
            "windows": {
                "program": "${workspaceFolder}/Source/HelixToolkit-Nex/${input:sampleWindows}"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "inputs": [
        {
            // Linux: relative path (from Source/HelixToolkit-Nex) to the
            // LinuxDebug build output (no file extension on the apphost).
            "id": "sample",
            "type": "pickString",
            "description": "Select the sample to run",
            "default": "Samples/GraphicsAPI/HelloTriangle/bin/LinuxDebug/net9.0/HelloTriangle",
            "options": [
                {
                    "label": "GraphicsAPI / HelloTriangle",
                    "value": "Samples/GraphicsAPI/HelloTriangle/bin/LinuxDebug/net9.0/HelloTriangle"
                },
                {
                    "label": "GraphicsAPI / MeshCulling",
                    "value": "Samples/GraphicsAPI/MeshCulling/bin/LinuxDebug/net9.0/MeshCulling"
                },
                {
                    "label": "GraphicsAPI / InstancingMeshCulling",
                    "value": "Samples/GraphicsAPI/InstancingMeshCulling/bin/LinuxDebug/net9.0/InstancingMeshCulling"
                },
                {
                    "label": "GraphicsAPI / ForwardPlusSimple",
                    "value": "Samples/GraphicsAPI/ForwardPlusSimple/bin/LinuxDebug/net9.0/ForwardPlusSimple"
