                },
                {
                    "label": "Integration / GizmoTest",
                    "value": "Samples/Integration/GizmoTest/bin/LinuxDebug/net9.0/GizmoTest"
                },
                {
                    "label": "Integration / ImGui",
                    "value": "Samples/Integration/ImGui/bin/LinuxDebug/net9.0/ImGui"
                },
                {
                    "label": "Integration / InstancingDemo",
