{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Source/HelixToolkit-Nex/HelixToolkit.Nex.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            // Builds ONLY the sample selected in the launch dropdown, instead
            // of the whole solution. The ${input:sample}/${input:sampleWindows}
            // value is a build *output* path (…/<proj>/bin/<cfg>/<tfm>/<app>);
            // we strip everything from "/bin/" onward to recover the project
            // directory and run `dotnet build` on it (which builds that project
            // plus its referenced libraries). This is a `shell` task so the
            // string trim can run in the shell; it reuses the same ${input:}
            // the launch config uses, so the dropdown is still a single prompt.
            // Default is the LinuxDebug config; the "windows" override uses the
            // Debug config (which the slnx maps WinUI -> x64).
            "label": "build-sample",
            "type": "shell",
            "command": "p='${input:sample}'; dotnet build \"${workspaceFolder}/Source/HelixToolkit-Nex/${p%%/bin/*}\" -c LinuxDebug /property:GenerateFullPaths=true '/consoleloggerparameters:NoSummary;ForceNoAlign'",
            "windows": {
                "command": "$p = '${input:sampleWindows}'; dotnet build \"${workspaceFolder}/Source/HelixToolkit-Nex/$($p -replace '/bin/.*$','')\" -c Debug /property:GenerateFullPaths=true '/consoleloggerparameters:NoSummary;ForceNoAlign'"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Source/HelixToolkit-Nex/HelixToolkit.Nex.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/Source/HelixToolkit-Nex/HelixToolkit.Nex.sln"
            ],
            "problemMatcher": "$msCompile"
        }
    ],
    "inputs": [
